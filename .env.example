# docker-compose.yml이 참조하는 환경변수 목록입니다.
# 실제 값을 채운 파일은 .env로 저장하고 절대 커밋하지 마세요 (.gitignore에 이미 포함됨).

# ── Database ──
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── Redis (matching-service) ──
REDIS_HOST=
REDIS_PORT=

# ── JWT ──
# user-service, order-service, store-service, store-ai-service, matching-service가
# 모두 동일한 값을 사용해야 서로 발급/검증한 토큰이 호환됩니다.
JWT_SECRET_KEY=

# 서비스 간 /internal API 호출에 쓰는 공유 키 (모든 서비스 동일, 예: openssl rand -hex 32)
INTERNAL_API_KEY=

# ── OAuth2: Kakao ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# ── OAuth2: Google ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── OAuth2: Naver ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=

# ── Kakao Pay (order-service) ──
KAKAO_PAY_SECRET_KEY=
KAKAO_PAY_APPROVAL_URL=
KAKAO_PAY_CANCEL_URL=
KAKAO_PAY_FAIL_URL=

# ── Gemini API (store-ai-service, matching-service) ──
GEMINI_API_KEY=

# ── Tesseract OCR (matching-service) ──
# 비워두면 Dockerfile 기본값(/usr/share/tesseract-ocr/4.00/tessdata)이 사용됩니다.
TESSDATA_PREFIX=

# ── File upload (store-service) ──
FILE_UPLOAD_DIR=

# ── Firebase (user-service) ──
# Firebase 서비스 계정 키(JSON) 파일을 컨테이너에 마운트한 뒤, 그 경로를 지정하세요.
# 비워두면 FCM 기능만 비활성화되고 나머지 기능은 정상 동작합니다.
FIREBASE_CREDENTIALS_PATH=
